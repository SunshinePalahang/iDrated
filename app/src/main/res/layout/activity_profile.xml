<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF5FF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp">

            <!-- Back Button -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/darkerBackgroundColor"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:backgroundTint="@color/buttonDarker"
                android:layout_marginEnd="16dp"
                android:textStyle="bold"
                android:padding="10dp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <TextView
            android:layout_width="134dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/profile_image_input"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dflt_user" />

        <Button
            android:id="@+id/change_avatar_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Avatar"
            android:backgroundTint="@color/button"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/white" />

        <EditText
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your username"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your age"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/gender_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/activity_level_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/urine_check_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/health_condition_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/poppins"
                android:text="Health Condition:"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/health_condition_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EAF5FF"
                android:fontFamily="@font/poppins"
                android:padding="8dp"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="16sp" />
        </LinearLayout>


        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="@color/button"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
