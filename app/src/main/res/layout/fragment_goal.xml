<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF5FF"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/goalDisplayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Goal:"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goalDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/goalConsumedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Water Consumed:"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goalConsumed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:progress="0"
        android:max="100" />

    <TextView
        android:id="@+id/percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00%"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/deviceDropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/buttonDarker"
        android:text="Connect" />

    <TextView
        android:id="@+id/deviceNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No device connected"
        android:layout_marginBottom="16dp"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/receivedDataTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Received: None"
        android:layout_marginBottom="16dp"
        android:textAlignment="center" />
</LinearLayout>