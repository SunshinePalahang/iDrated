<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Message Text -->
    <TextView
        android:id="@+id/notificationMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification message"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/notificationTime"
        android:layout_marginEnd="8dp"
        android:maxWidth="0dp"
        android:layout_alignParentLeft="true" />

    <!-- Timestamp (date and time) below message -->
    <TextView
        android:id="@+id/notificationTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apr 25, 2025 10:30 AM"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_below="@id/notificationMessage"
        android:layout_alignStart="@id/notificationMessage"
        android:layout_alignLeft="@id/notificationMessage"
        android:layout_marginTop="4dp" />

    <!-- Relative time on the right -->
    <TextView
        android:id="@+id/notificationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 hr ago"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true" />
</RelativeLayout>
