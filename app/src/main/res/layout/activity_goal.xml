<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ADD8E6"
    android:paddingTop="50dp"
    tools:context=".GoalActivity">

    <!-- Back Button -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/darkerBackgroundColor"
        android:gravity="center"
        android:text="&lt;"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:backgroundTint="@color/buttonDarker"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:paddingTop="6dp"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:progress="0"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar"
        android:rotation="270"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />

    <!-- Percent  -->

    <TextView
        android:id="@+id/percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textAlignment="center"
        android:textColor="#00008B"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="@id/progressBar"
        app:layout_constraintTop_toTopOf="@id/progressBar"
        app:layout_constraintVertical_bias="0.404" />

    <!-- Goal Group  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goalGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/percent"
        app:layout_constraintStart_toStartOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="@id/progressBar">

        <TextView
            android:id="@+id/goalConsumed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="000"
            android:textColor="#00008B"
            android:textSize="25sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_slash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/"
            android:textColor="#00008B"
            android:textSize="25sp"
            app:layout_constraintStart_toEndOf="@id/goalConsumed"
            app:layout_constraintTop_toTopOf="@id/goalConsumed" />

        <TextView
            android:id="@+id/goalDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="000"
            android:textColor="#00008B"
            android:textSize="25sp"
            app:layout_constraintStart_toEndOf="@id/tv_slash"
            app:layout_constraintTop_toTopOf="@id/tv_slash" />

        <TextView
            android:id="@+id/tv_ml"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#00008B"
            android:textSize="25sp"
            app:layout_constraintStart_toEndOf="@id/goalDisplay"
            app:layout_constraintTop_toTopOf="@id/goalDisplay" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Water input and button -->
    <EditText
        android:id="@+id/waterInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter amount in ml"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="@drawable/rounded_input_bg"
        android:textColor="#000000"
        android:textColorHint="#666666"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/addWaterButton"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/addWaterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Water taken"
        android:textColor="@android:color/white"
        android:backgroundTint="#006bb3"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="@id/waterInput"
        app:layout_constraintBottom_toBottomOf="@id/waterInput"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <!-- Goal input and save button -->
    <EditText
        android:id="@+id/GoalInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter amount in ml"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="@drawable/rounded_input_bg"
        android:textColor="#000000"
        android:textColorHint="#666666"
        app:layout_constraintTop_toBottomOf="@id/waterInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/GoalButton"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/GoalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save goal"
        android:textColor="@android:color/white"
        android:backgroundTint="#006bb3"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="@id/GoalInput"
        app:layout_constraintBottom_toBottomOf="@id/GoalInput"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <!-- Dropdown and Connect Button -->
    <Spinner
        android:id="@+id/deviceDropdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@id/GoalButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="16dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Connect"
        app:layout_constraintTop_toBottomOf="@id/deviceDropdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#006bb3"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp" />

    <TextView
        android:id="@+id/deviceNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No device connected"
        android:textSize="16sp"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/connectButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp" />

    <TextView
        android:id="@+id/receivedDataTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Received Data: "
        android:textSize="16sp"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/deviceNameTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>